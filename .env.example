# ── contracts/.env ──────────────────────────────────────────────────────────────
# Deployer private key (no 0x prefix needed by hardhat-dotenv, but add it)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# The secret phrase the LLM is guarding (used to compute secretHash at deploy time)
SECRET=your-hard-to-guess-secret-phrase

# ── frontend/.env.local ─────────────────────────────────────────────────────────
# Server-side only (never exposed to browser)
LLM_BASE_URL=http://your-llm-server:8000/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-model-name
# Same SECRET used during contract deployment
SECRET=your-hard-to-guess-secret-phrase
CONTRACT_ADDRESS=0xDEPLOYED_CONTRACT_ADDRESS

# Client-side (NEXT_PUBLIC_ prefix exposes to browser)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xDEPLOYED_CONTRACT_ADDRESS
NEXT_PUBLIC_CHAIN_ID=84532
# Base mainnet: 8453  |  Base Sepolia (testnet): 84532
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID
